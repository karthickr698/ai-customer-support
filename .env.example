# TypeScript API (apps/api)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_customer_support
REDIS_URL=redis://localhost:6380

# Optional docker-compose host ports when 5432 or 6380 are already in use:
# POSTGRES_PORT=5432
# REDIS_PORT=6380

JWT_SECRET=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
INVITATION_TTL_SECONDS=604800
WIDGET_SESSION_TTL_SECONDS=2592000
ATTACHMENT_STORAGE_DIR=./data/attachments
KNOWLEDGE_STORAGE_DIR=./data/knowledge

WEB_ORIGIN=http://localhost:5173

# Auth email. Leave SMTP_URL empty to log messages in development.
EMAIL_FROM=noreply@localhost
SMTP_URL=

# Google OAuth. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# TypeScript API → Python AI service (apps/ai). Not an LLM provider URL.
AI_SERVICE_URL=http://localhost:8000

# Frontend (Vite). Leave empty in local development to use the Vite proxy to the API.
VITE_API_BASE_URL=

# Python AI service (apps/ai). Not loaded by the TypeScript API.
# Empty / heuristic: local onboarding without a live model. openai: Chat Completions.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Embeddings. Empty / hash: local ingestion without a live model. openai: Embeddings API.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

AI_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=info
