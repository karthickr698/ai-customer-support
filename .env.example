# TypeScript API (apps/api)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_customer_support
REDIS_URL=redis://localhost:6379

# Optional docker-compose host ports when 5432 or 6379 are already in use:
# POSTGRES_PORT=5432
# REDIS_PORT=6379

JWT_SECRET=change-me-to-a-long-random-secret-key

WEB_ORIGIN=http://localhost:5173

# TypeScript API → Python AI service (apps/ai). Not an LLM provider URL.
AI_SERVICE_URL=http://localhost:8000

# Frontend (Vite). Leave empty in local development to use the Vite proxy to the API.
VITE_API_BASE_URL=

# Python AI service (apps/ai). Not loaded by the TypeScript API.
LLM_PROVIDER=
LLM_API_KEY=

AI_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=info
