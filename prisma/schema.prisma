generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at")
  status          String
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")

  refreshSessions RefreshSession[]
  oneTimeTokens   AuthOneTimeToken[]
  oauthAccounts   OAuthAccount[]

  @@map("users")
}

model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  status    String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  memberships     Membership[]
  invitations     Invitation[]
  auditLogs       OrganizationAuditLog[]
  conversations   Conversation[]
  escalationRules EscalationRule[]
  onboarding      OrganizationOnboarding?
  knowledgeSources KnowledgeSource[]
  knowledgeDocuments KnowledgeDocument[]
  widgetConfiguration WidgetConfiguration?
  widgetSessions  WidgetSession[]
  messageAttachments MessageAttachment[]
  integrationCredentials IntegrationCredential[]
  oauthConnectors OAuthConnector[]
  toolInvocations ToolInvocation[]
  apiKeys OrganizationApiKey[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries WebhookDelivery[]
  oauthApplications OrganizationOAuthApplication[]
  oauthGrants OrganizationOAuthGrant[]
  customers Customer[]
  products Product[]
  orders CommerceOrder[]
  shipments Shipment[]
  returns CommerceReturn[]
  tickets Ticket[]
  ticketNotes TicketNote[]
  ticketAttachments TicketAttachment[]
  ticketSlaPolicies TicketSlaPolicy[]
  ticketEscalationPolicies TicketEscalationPolicy[]

  @@map("organizations")
}

model Membership {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  status         String
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  email           String
  role            String
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model OrganizationAuditLog {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  occurredAt     DateTime @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, action, occurredAt])
  @@map("organization_audit_logs")
}

model RefreshSession {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @map("created_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model AuthOneTimeToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_one_time_tokens")
}

model OAuthAccount {
  id                String   @id @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model IdentityAuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  occurredAt DateTime @map("occurred_at")

  @@index([actorId])
  @@index([action, occurredAt])
  @@map("identity_audit_logs")
}

model Conversation {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  customerId         String?   @map("customer_id") @db.Uuid
  customerEmail      String    @map("customer_email")
  customerName       String    @map("customer_name")
  subject            String?
  status             String
  assignedAgentId    String?   @map("assigned_agent_id") @db.Uuid
  channel            String
  lastMessageAt         DateTime? @map("last_message_at")
  lastMessagePreview    String?   @map("last_message_preview")
  lastMessageAuthorType String?   @map("last_message_author_type")
  createdByUserId       String?   @map("created_by_user_id") @db.Uuid
  widgetSessionId       String?   @map("widget_session_id") @db.Uuid
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgetSession WidgetSession?    @relation(fields: [widgetSessionId], references: [id], onDelete: SetNull)
  messages     Message[]
  notes        ConversationNote[]
  tags         ConversationTag[]
  attachments  MessageAttachment[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
  @@index([organizationId, customerEmail])
  @@index([organizationId, widgetSessionId])
  @@map("conversations")
}

model Message {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorType     String   @map("author_type")
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("messages")
}

model ConversationNote {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("conversation_notes")
}

model ConversationTag {
  id             String @id @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, name])
  @@index([organizationId, name])
  @@map("conversation_tags")
}

model EscalationRule {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  enabled        Boolean  @default(true)
  triggerType    String   @map("trigger_type")
  triggerMinutes Int?     @map("trigger_minutes")
  keywords       String[] @default([])
  action         String
  priority       Int      @default(100)
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled, priority])
  @@map("escalation_rules")
}

model OrganizationOnboarding {
  id              String   @id @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  status          String
  businessProfile Json?    @map("business_profile")
  tonePresets     Json?    @map("tone_presets")
  selectedToneId  String?  @map("selected_tone_id")
  agentSettings   Json?    @map("agent_settings")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_onboardings")
}

model KnowledgeSource {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  type            String
  name            String
  url             String?
  description     String?
  status          String
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    KnowledgeDocument[]

  @@index([organizationId, createdAt])
  @@map("knowledge_sources")
}

model KnowledgeDocument {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  sourceId        String?   @map("source_id") @db.Uuid
  kind            String
  title           String
  sourceUri       String?   @map("source_uri")
  mediaType       String?   @map("media_type")
  fileName        String?   @map("file_name")
  storageKey      String?   @map("storage_key")
  articleText     String?   @map("article_text")
  checksum        String?
  status          String
  version         Int       @default(1)
  chunkCount      Int       @default(0) @map("chunk_count")
  embeddingModel  String?   @map("embedding_model")
  parser          String?
  failureCode     String?   @map("failure_code")
  failureMessage  String?   @map("failure_message")
  indexedAt       DateTime? @map("indexed_at")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, sourceId])
  @@map("knowledge_documents")
}

model WidgetConfiguration {
  id                String   @id @db.Uuid
  organizationId    String   @unique @map("organization_id") @db.Uuid
  publicKey         String   @unique @map("public_key")
  enabled           Boolean  @default(true)
  title             String
  greeting          String
  primaryColor      String   @map("primary_color")
  position          String
  launcherText      String   @map("launcher_text")
  collectEmail      Boolean  @map("collect_email")
  allowAnonymous    Boolean  @map("allow_anonymous")
  allowAttachments  Boolean  @map("allow_attachments")
  aiEnabled         Boolean  @map("ai_enabled")
  offlineMessage    String   @map("offline_message")
  allowedOrigins    String[] @default([]) @map("allowed_origins")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     WidgetSession[]

  @@map("widget_configurations")
}

model WidgetSession {
  id                     String    @id @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  widgetConfigurationId  String    @map("widget_configuration_id") @db.Uuid
  visitorId              String    @map("visitor_id")
  kind                   String
  email                  String?
  name                   String?
  customerId             String?   @map("customer_id") @db.Uuid
  tokenHash              String    @unique @map("token_hash")
  expiresAt              DateTime  @map("expires_at")
  lastSeenAt             DateTime  @map("last_seen_at")
  revokedAt              DateTime? @map("revoked_at")
  createdAt              DateTime  @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widget       WidgetConfiguration @relation(fields: [widgetConfigurationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  attachments   MessageAttachment[]

  @@index([organizationId, visitorId])
  @@index([organizationId, expiresAt])
  @@map("widget_sessions")
}

model MessageAttachment {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  messageId        String?  @map("message_id") @db.Uuid
  widgetSessionId  String?  @map("widget_session_id") @db.Uuid
  fileName         String   @map("file_name")
  contentType      String   @map("content_type")
  byteSize         Int      @map("byte_size")
  storageKey       String   @map("storage_key")
  createdAt        DateTime @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  widgetSession WidgetSession?  @relation(fields: [widgetSessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId])
  @@index([messageId])
  @@map("message_attachments")
}

model IntegrationCredential {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  toolName         String    @map("tool_name")
  provider         String?
  name             String
  kind             String
  headerName       String    @map("header_name")
  baseUrl          String    @map("base_url")
  secretCiphertext String    @map("secret_ciphertext")
  secretNonce      String    @map("secret_nonce")
  secretLastFour   String    @map("secret_last_four")
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @map("created_at")
  updatedAt        DateTime  @map("updated_at")
  revokedAt        DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, toolName])
  @@index([organizationId, revokedAt])
  @@map("integration_credentials")
}

model OAuthConnector {
  id                     String    @id @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  provider               String
  name                   String
  status                 String
  authorizationUrl       String    @map("authorization_url")
  tokenUrl               String    @map("token_url")
  clientId               String    @map("client_id")
  clientSecretCiphertext String    @map("client_secret_ciphertext")
  clientSecretNonce      String    @map("client_secret_nonce")
  scopes                 String[]  @default([])
  accessTokenCiphertext  String?   @map("access_token_ciphertext")
  accessTokenNonce       String?   @map("access_token_nonce")
  refreshTokenCiphertext String?   @map("refresh_token_ciphertext")
  refreshTokenNonce      String?   @map("refresh_token_nonce")
  tokenExpiresAt         DateTime? @map("token_expires_at")
  externalAccountId      String?   @map("external_account_id")
  createdByUserId        String    @map("created_by_user_id") @db.Uuid
  createdAt              DateTime  @map("created_at")
  updatedAt              DateTime  @map("updated_at")
  disconnectedAt         DateTime? @map("disconnected_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, status])
  @@map("oauth_connectors")
}

model ToolInvocation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  toolName       String    @map("tool_name")
  conversationId String?   @map("conversation_id") @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  actorType      String    @map("actor_type")
  status         String
  arguments      Json
  result         Json?
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  attemptCount   Int       @map("attempt_count")
  durationMs     Int       @map("duration_ms")
  credentialId   String?   @map("credential_id") @db.Uuid
  connectorId    String?   @map("connector_id") @db.Uuid
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")
  correlationId  String?   @map("correlation_id")
  createdAt      DateTime  @map("created_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, toolName, createdAt])
  @@map("tool_invocations")
}

model OrganizationApiKey {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  prefix          String
  tokenHash       String    @unique @map("token_hash")
  scopes          String[]
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @map("created_at")
  revokedAt       DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
  @@map("organization_api_keys")
}

model WebhookSubscription {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  url              String
  description      String?
  events           String[]
  secretCiphertext String    @map("secret_ciphertext")
  secretNonce      String    @map("secret_nonce")
  secretLastFour   String    @map("secret_last_four")
  status           String
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @map("created_at")
  updatedAt        DateTime  @map("updated_at")
  disabledAt       DateTime? @map("disabled_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, status])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventName      String    @map("event_name")
  payload        Json
  status         String
  attemptCount   Int       @map("attempt_count")
  responseStatus Int?      @map("response_status")
  errorMessage   String?   @map("error_message")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  createdAt      DateTime  @map("created_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

model OrganizationOAuthApplication {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  name                 String
  clientId             String    @unique @map("client_id")
  clientSecretHash     String    @map("client_secret_hash")
  clientSecretLastFour String    @map("client_secret_last_four")
  redirectUris         String[]  @map("redirect_uris")
  scopes               String[]
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  createdAt            DateTime  @map("created_at")
  updatedAt            DateTime  @map("updated_at")
  revokedAt            DateTime? @map("revoked_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grants       OrganizationOAuthGrant[]

  @@index([organizationId, revokedAt])
  @@map("organization_oauth_applications")
}

model OrganizationOAuthGrant {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  applicationId    String    @map("application_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  codeHash         String?   @unique @map("code_hash")
  codeChallenge    String    @map("code_challenge")
  redirectUri      String    @map("redirect_uri")
  scopes           String[]
  accessTokenHash  String?   @unique @map("access_token_hash")
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime? @map("access_expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  createdAt        DateTime  @map("created_at")
  consumedAt       DateTime? @map("consumed_at")
  revokedAt        DateTime? @map("revoked_at")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application  OrganizationOAuthApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId, applicationId])
  @@map("organization_oauth_grants")
}

model Customer {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  email              String
  name               String
  phone              String?
  status             String
  externalCustomerId String?  @map("external_customer_id")
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       CommerceOrder[]

  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
  @@index([organizationId, externalCustomerId])
  @@map("customers")
}

model Product {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  sku             String
  name            String
  description     String?
  status          String
  currency        String
  priceAmount     Int      @map("price_amount")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sku])
  @@index([organizationId, createdAt])
  @@map("products")
}

model CommerceOrder {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  externalOrderId String   @map("external_order_id")
  status          String
  currency        String
  totalAmount     Int      @map("total_amount")
  lineItems       Json     @map("line_items")
  placedAt        DateTime @map("placed_at")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipments    Shipment[]
  returns      CommerceReturn[]

  @@unique([organizationId, externalOrderId])
  @@index([organizationId, createdAt])
  @@index([organizationId, customerId])
  @@map("commerce_orders")
}

model Shipment {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  trackingNumber      String    @map("tracking_number")
  carrier             String
  status              String
  shippedAt           DateTime? @map("shipped_at")
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @map("created_at")
  updatedAt           DateTime  @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([organizationId, trackingNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, orderId])
  @@map("shipments")
}

model CommerceReturn {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  status          String
  reason          String?
  requestedAt     DateTime @map("requested_at")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, orderId])
  @@map("commerce_returns")
}

model Ticket {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  conversationId     String?   @map("conversation_id") @db.Uuid
  customerId         String?   @map("customer_id") @db.Uuid
  customerEmail      String    @map("customer_email")
  customerName       String    @map("customer_name")
  subject            String
  description        String
  status             String
  priority           String
  source             String
  assignedAgentId    String?   @map("assigned_agent_id") @db.Uuid
  escalatedAt        DateTime? @map("escalated_at")
  firstRespondedAt   DateTime? @map("first_responded_at")
  resolvedAt         DateTime? @map("resolved_at")
  closedAt           DateTime? @map("closed_at")
  slaPolicyId        String?   @map("sla_policy_id") @db.Uuid
  firstResponseDueAt DateTime? @map("first_response_due_at")
  resolutionDueAt    DateTime? @map("resolution_due_at")
  slaPausedAt        DateTime? @map("sla_paused_at")
  slaBreachedAt      DateTime? @map("sla_breached_at")
  slaBreachKind      String?   @map("sla_breach_kind")
  createdByUserId    String?   @map("created_by_user_id")
  createdAt          DateTime  @map("created_at")
  updatedAt          DateTime  @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slaPolicy    TicketSlaPolicy?      @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  notes        TicketNote[]
  attachments  TicketAttachment[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
  @@index([organizationId, conversationId])
  @@index([organizationId, firstResponseDueAt])
  @@index([organizationId, resolutionDueAt])
  @@map("tickets")
}

model TicketNote {
  id             String   @id @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String   @map("author_id")
  body           String
  createdAt      DateTime @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ticket_notes")
}

model TicketAttachment {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  byteSize       Int      @map("byte_size")
  storageKey     String   @map("storage_key")
  createdAt      DateTime @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId, ticketId])
  @@map("ticket_attachments")
}

model TicketSlaPolicy {
  id                   String   @id @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  name                 String
  enabled              Boolean  @default(true)
  appliesToPriority    String   @map("applies_to_priority")
  firstResponseMinutes Int      @map("first_response_minutes")
  resolutionMinutes    Int      @map("resolution_minutes")
  createdAt            DateTime @map("created_at")
  updatedAt            DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([organizationId, appliesToPriority])
  @@index([organizationId, enabled])
  @@map("ticket_sla_policies")
}

model TicketEscalationPolicy {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  enabled        Boolean  @default(true)
  triggerType    String   @map("trigger_type")
  triggerMinutes Int?     @map("trigger_minutes")
  action         String
  priority       Int      @default(100)
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled, priority])
  @@map("ticket_escalation_policies")
}
