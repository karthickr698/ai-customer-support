generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at")
  status          String
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")

  refreshSessions RefreshSession[]
  oneTimeTokens   AuthOneTimeToken[]
  oauthAccounts   OAuthAccount[]

  @@map("users")
}

model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  status    String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  memberships   Membership[]
  invitations   Invitation[]
  auditLogs     OrganizationAuditLog[]
  conversations Conversation[]

  @@map("organizations")
}

model Membership {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  status         String
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  email           String
  role            String
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model OrganizationAuditLog {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  occurredAt     DateTime @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, action, occurredAt])
  @@map("organization_audit_logs")
}

model RefreshSession {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @map("created_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model AuthOneTimeToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_one_time_tokens")
}

model OAuthAccount {
  id                String   @id @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model IdentityAuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  occurredAt DateTime @map("occurred_at")

  @@index([actorId])
  @@index([action, occurredAt])
  @@map("identity_audit_logs")
}

model Conversation {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  customerId         String?   @map("customer_id") @db.Uuid
  customerEmail      String    @map("customer_email")
  customerName       String    @map("customer_name")
  subject            String?
  status             String
  assignedAgentId    String?   @map("assigned_agent_id") @db.Uuid
  channel            String
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @map("created_at")
  updatedAt          DateTime  @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]
  notes        ConversationNote[]
  tags         ConversationTag[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
  @@index([organizationId, customerEmail])
  @@map("conversations")
}

model Message {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorType     String   @map("author_type")
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("messages")
}

model ConversationNote {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("conversation_notes")
}

model ConversationTag {
  id             String @id @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, name])
  @@index([organizationId, name])
  @@map("conversation_tags")
}
