{
  "info": {
    "_postman_id": "c4e8d2b1-7a91-4f3e-8c5a-ai-customer-support",
    "name": "AI Customer Support API",
    "description": "HTTP APIs for the TypeScript backend (`apps/api`).\n\n**Setup**\n1. Import this collection and `local.postman_environment.json`.\n2. Select the **AI Customer Support — Local** environment.\n3. Keep cookies enabled (Postman → Cookies). Login, email verify, and Google complete set `access_token` and `refresh_token` httpOnly cookies.\n\n**Auth flow**\n1. Register\n2. Copy the verification token from the API logs (development console email) into `verificationToken`\n3. Verify email (sets session cookies)\n4. Call Get current user, Refresh, or Logout\n\nPasswords must be at least 12 characters and include a letter and a number.\n\nGoogle OAuth: Start Google sign-in → open `googleAuthorizationUrl` in a browser → after redirect, put the `code` query value into `googleLoginCode` → Complete Google sign-in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.request.headers.has('x-request-id')) {",
          "  pm.request.headers.add({ key: 'x-request-id', value: pm.variables.replaceIn('{{$guid}}') });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/health",
            "description": "Process liveness. Returns 200 even if PostgreSQL or Redis are down."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/ready",
            "description": "Infrastructure readiness for PostgreSQL and Redis. 200 when both are up, 503 otherwise."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns readiness payload', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('status');",
                  "  pm.expect(body).to.have.property('checks');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register & email verification",
          "item": [
            {
              "name": "Register",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"{{displayName}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/register",
                "description": "Creates an unverified account and sends a verification email. In development the verify URL is logged by the console email adapter. Does not set session cookies."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Created unverified user', () => {",
                      "  pm.response.to.have.status(201);",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.user.email).to.eql(pm.environment.get('email').toLowerCase());",
                      "  pm.expect(body.user.emailVerified).to.eql(false);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Resend verification email",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/email/resend",
                "description": "Sends a new verification link if an unverified password account exists. Always returns a generic success message."
              }
            },
            {
              "name": "Verify email",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/email/verify",
                "description": "Consumes the email verification token from the link (`?token=`). Sets `access_token` and `refresh_token` cookies and returns the verified user."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Email verified and session issued', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json().user.emailVerified).to.eql(true);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Session",
          "item": [
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/login",
                "description": "Password login. Email must already be verified. Sets `access_token` and `refresh_token` cookies. Rate limited per IP and email."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Logged in', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.have.nested.property('user.id');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get current user",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{baseUrl}}/api/auth/me",
                "description": "Returns the authenticated user. Requires a valid `access_token` cookie or `Authorization: Bearer` access token."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns the current user', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.have.nested.property('user.email');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Refresh session",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": ""
                },
                "url": "{{baseUrl}}/api/auth/refresh",
                "description": "Rotates the refresh token using the `refresh_token` cookie and issues a new access cookie. Reusing a previous refresh token revokes the whole family."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Session refreshed', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.have.nested.property('user.id');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": ""
                },
                "url": "{{baseUrl}}/api/auth/logout",
                "description": "Revokes the current refresh session and clears auth cookies. Returns 204."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Logged out', () => pm.response.to.have.status(204));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Password reset",
          "item": [
            {
              "name": "Forgot password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/password/forgot",
                "description": "Requests a password reset email. Always returns a generic success message. In development the reset URL is logged by the console email adapter — copy `?token=` into `resetToken`."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Accepted', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.have.property('message');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Reset password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{newPassword}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/password/reset",
                "description": "Sets a new password, revokes all refresh sessions, and clears cookies. Then sign in with `newPassword`."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Password updated', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.have.property('message');",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Google OAuth",
          "item": [
            {
              "name": "Start Google sign-in",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": ""
                },
                "url": "{{baseUrl}}/api/auth/google/start",
                "description": "Returns a Google authorization URL with PKCE. Open `authorizationUrl` in a browser. Requires `GOOGLE_CLIENT_ID`, `GOOGLE_CLIENT_SECRET`, and `GOOGLE_REDIRECT_URI`."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const url = pm.response.json().authorizationUrl;",
                      "  pm.environment.set('googleAuthorizationUrl', url);",
                      "  pm.test('Authorization URL returned', () => pm.expect(url).to.be.a('string'));",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Google OAuth callback",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{baseUrl}}/api/auth/google/callback?code={{googleOAuthCode}}&state={{googleOAuthState}}",
                "description": "Google redirects here after consent. The API exchanges the OAuth code, then redirects to the web app with a one-time login code. Normally invoked by Google, not Postman. Disable auto-follow redirects to inspect the Location header."
              }
            },
            {
              "name": "Complete Google sign-in",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"{{googleLoginCode}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/google/complete",
                "description": "Exchanges the one-time login code from `/auth/callback?code=` for session cookies. The code is single-use and expires quickly."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Google session issued', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.have.nested.property('user.email');",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
